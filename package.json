{
  "name": "tejitpabari-website",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "Tejit Pabari (tejitpabari99@gmail.com)",
  "license": "0BSD",
  "repository": {
    "type": "git",
    "url": "https://github.com/tejitpabari99/tejitpabari"
  },
  "bugs": {
    "url": "https://github.com/tejitpabari99/tejitpabari/issues"
  },
  "scripts": {
    "dev": "vite-react-ssg dev",
    "dev:admin": "vite -c vite.admin.config.ts",
    "typecheck": "tsc -b --noEmit",
    "prebuild": "node scripts/generate-og-cards.mjs && node scripts/generate-sitemap.mjs",
    "build": "npm run typecheck && vite-react-ssg build",
    "build:admin": "tsc -p tsconfig.admin.json --noEmit && vite build -c vite.admin.config.ts",
    "build:all": "npm run build && npm run build:admin",
    "postbuild": "node scripts/normalize-ssg-build-id.mjs && node scripts/inject-csp-hashes.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:admin": "vitest run -c vite.admin.config.ts",
    "check:launch": "CHECK_LAUNCH=1 vitest run scripts/check-launch-content.test.ts && npm run check:no-forms && npm run check:no-em-dash",
    "check:admin-build": "node scripts/check-admin-build.mjs",
    "check:no-forms": "bash scripts/check-no-forms.sh",
    "check:no-em-dash": "node scripts/check-no-em-dash.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "emulators": "firebase emulators:start --only auth,firestore,hosting --project tejitpabari-99",
    "test:rules": "firebase emulators:exec --only firestore --project tejitpabari-99 \"node --test tests/rules/*.test.js\"",
    "test:migrate": "firebase emulators:exec --only firestore --project tejitpabari-99 \"node --test tests/migrate/*.test.js\"",
    "test:data": "firebase emulators:exec --only firestore --project tejitpabari-99 \"node --test --test-concurrency=1 tests/data/*.test.js\"",
    "test:go": "firebase emulators:exec --only firestore --project tejitpabari-99 \"node --test tests/go/*.test.js\"",
    "test:node": "node --test tests/unit/*.test.js",
    "test:emulator": "firebase emulators:exec --only firestore --project tejitpabari-99 \"node --test --test-concurrency=1 tests/rules/*.test.js tests/migrate/*.test.js tests/data/*.test.js tests/go/*.test.js\"",
    "migrate": "node scripts/migrate-to-firestore.js",
    "deploy:static": "firebase deploy --only hosting:go,hosting:nonprofit,hosting:healthtech --project tejitpabari-99"
  },
  "dependencies": {
    "buffer": "^6.0.3",
    "firebase": "^12.19.0",
    "fuse.js": "^7.5.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.39.0",
    "marked": "^17.0.6",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^6.14.1",
    "remark-gfm": "^4.0.1",
    "vite-react-ssg": "^0.9.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "autoprefixer": "^10.5.4",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "firebase-admin": "^13.10.0",
    "firebase-tools": "^15.36.0",
    "globals": "^17.11.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "prettier": "^3.8.1",
    "satori": "^0.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
