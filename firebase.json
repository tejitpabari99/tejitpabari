{
  "hosting": {
    "public": "dist",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000; includeSubDomains"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com 'sha256-+Ozb/ItuZAdaQgJd2RebN2rKWj1XkBuXVaV6/lT4Juo=' 'sha256-+t5Z3fJi7uJxARWEzFEVaSRgtaAn0r97XkxpJNbQiK0=' 'sha256-16hytVw2SSX3hkefJiVxan9CS+QkbJsd2H4IUWw8haw=' 'sha256-3T3SNxfkVCsSXLoqWCnMnaafmqifqcz/19S077omPB0=' 'sha256-Ed6Lei7deBSXT1iYYw0V36YZXaA4v7OsRknNjmNl/9c=' 'sha256-FHfozmosNdt5yUG9l8OmVM1S/oTxw2TNWHPejSjEr58=' 'sha256-Gu9zTsfluGJpkymXgR9+InomERohT7wqIZHED60BNEk=' 'sha256-S6wmYHJnHLN8bUgDFzGTw0ZpwUWUXsqLebjcjIjFqEw=' 'sha256-fGiNU6ZDUVs8auPa32WHrwMBEI5iKGxJo40pNCeaA5M=' 'sha256-kBRcNsbW8crj0MoebA9/qbHgRipNw3Gmn2wC/R9EQ1M=' 'sha256-liyTw1Iq0TVXTvNIye5Jk9SC8IRNr6p3dIccH/dUelU=' 'sha256-z0X5LPrfvX6G2I7DI8t+2LiBGSEpYw2Ji3UbggChwc0='; style-src 'self' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https://images.unsplash.com; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; form-action 'none'"
          }
        ]
      },
      {
        "source": "**/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/projects/clip-verse/live",
        "destination": "https://clipverse-five.vercel.app/",
        "type": 301
      },
      {
        "source": "/projects/columbia-virtual-campus/live",
        "destination": "https://columbiavirtualcampus.com/",
        "type": 301
      },
      {
        "source": "/projects/crunchy-filler/live",
        "destination": "https://chromewebstore.google.com/detail/crunchy-filler/djbcknbbfoldifpllefimnnkfaogcnid",
        "type": 301
      },
      {
        "source": "/projects/juno/live",
        "destination": "https://meetjuno.health/",
        "type": 301
      },
      {
        "source": "/projects/med-doc-tracker/live",
        "destination": "https://tejitpabari.short.gy/med-doc-tracker",
        "type": 301
      },
      {
        "source": "/projects/smarttest/live",
        "destination": "https://doi.org/10.1007/s10461-019-02718-y",
        "type": 301
      },
      {
        "source": "/research/dvmm-lab/live",
        "destination": "https://bit.ly/tejit-dvmm-lab-research-2020",
        "type": 301
      },
      {
        "source": "/research/flood-event-extraction-bangladesh/live",
        "destination": "https://bit.ly/tejit-flood-research",
        "type": 301
      },
      {
        "source": "/research/incite-labs/live",
        "destination": "https://incite.columbia.edu/measuring-liberal-arts",
        "type": 301
      },
      {
        "source": "/research/pill-recognition-prescription-extraction/live",
        "destination": "https://www.researchgate.net/publication/340528010_Pill_Detection_Prescription_Analysis",
        "type": 301
      },
      {
        "source": "/research/solar-illumination-water-bottle/live",
        "destination": "https://doi.org/10.7916/D8Q24BQ9",
        "type": 301
      }
    ]
  }
}
